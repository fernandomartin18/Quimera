# API Keys - Define solo las que vayas a usar
# LiteLLM las detecta automáticamente por el prefijo del modelo
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Cualquier otro proveedor soportado por LiteLLM:
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# BEDROCK_ACCESS_KEY=
# TOGETHER_API_KEY=
# etc.

# Default model (cualquier string LiteLLM)
DEFAULT_MODEL=gemini/gemini-2.0-flash

# Ollama / Local
OLLAMA_BASE_URL=http://localhost:11434

# App
LOG_LEVEL=INFO
