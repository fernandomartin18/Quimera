# Base URL del cliente API (relativa al frontend o absoluta si no hay proxy)
VITE_API_BASE_URL=/api

# Destino del proxy de desarrollo de Vite (backend FastAPI)
VITE_PROXY_TARGET=http://localhost:8000

# Base del cliente Ollama. Por defecto pasa por el proxy de Vite (/ollama).
# Para hablar directamente con Ollama (requiere CORS habilitado):
# VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_BASE_URL=/ollama

# Destino del proxy de Vite hacia Ollama (solo si usas /ollama)
OLLAMA_PROXY_TARGET=http://localhost:11434
